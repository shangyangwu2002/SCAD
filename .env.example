# Copy to .env locally; never commit .env.
# Launchers use local model directories populated by scripts/download_models.py.
# Optional paths (defaults are relative to the repository):
# export SCAD_DATA_ROOT="../SCAD_DATA"
# export SCAD_RUNTIME_ROOT="./runtime"
# export MODELS_ROOT="./models"
export HF_HUB_DISABLE_TELEMETRY=1
export WANDB_MODE=disabled
# LLM-judged runs require an OpenAI-compatible endpoint and explicit model.
export JUDGE_API_KEY=""
export JUDGE_API_BASE=""
export JUDGE_MODEL=""
# Live search evaluation; use your own service credentials.
export SERPAPI_API_KEYS=""
# Frozen multimodal training uses the packaged cache, with no public hosting.
# For LIVE image search, host dataset/public_images at a public URL and set this
# BEFORE preparing multimodal runtime tables. Use a new runtime root if changed.
# export MM_PUBLIC_IMAGE_BASE_URL="https://your-image-host.example/images"
# Alternatively, override the runtime map with publicly accessible HTTP(S) URLs:
# export MM_IMAGE_URL_MAP=""
# Optional token for official gated dataset downloads (keep local).
# HF_TOKEN=
